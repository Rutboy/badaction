{
  "name": "badaction",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone-licenses.mjs",
    "check:standalone": "node --test scripts/prepare-standalone-licenses.test.mjs && node scripts/check-standalone.mjs",
    "start": "node scripts/run-server.mjs --next-start",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-documentation.mjs",
    "check:repo": "node scripts/check-repository-hygiene.mjs",
    "check:licenses": "node --test scripts/check-licenses.test.mjs && node scripts/check-licenses.mjs",
    "security:check": "node scripts/check-security.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "test": "node --test --experimental-strip-types --experimental-specifier-resolution=node \"src/**/*.test.js\"",
    "test:database": "node scripts/test-database.mjs",
    "test:cleanup-integration": "node --env-file-if-exists=.env scripts/test-cleanup-expired.mjs",
    "test:upgrade-integration": "node --env-file-if-exists=.env scripts/test-upgrade-baseline.mjs",
    "test:access-smoke": "node --env-file-if-exists=.env scripts/test-access-smoke.mjs",
    "test:e2e": "node --env-file-if-exists=.env scripts/test-e2e.mjs",
    "test:docker": "node --env-file-if-exists=.env scripts/test-docker-compose.mjs",
    "docs:screenshot": "node --env-file-if-exists=.env scripts/test-e2e.mjs --update-product-screenshot",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "cleanup:expired": "node scripts/cleanup-expired.mjs",
    "smoke:access": "node scripts/smoke-access.mjs",
    "access:claim-owner": "node --env-file-if-exists=.env --experimental-strip-types --experimental-specifier-resolution=node scripts/issue-owner-claim.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:status": "prisma migrate status",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "^15.5.21",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.20.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
