# Copy this file to an ignored .env.production file and fill every blank value.
# Generate the three database passwords and three application secrets
# independently (six separate values), using this command for each:
# openssl rand -hex 32

COMPOSE_PROJECT_NAME=badaction-production

POSTGRES_DB=retro
POSTGRES_USER=badaction_admin
POSTGRES_PASSWORD=
POSTGRES_MIGRATOR_USER=badaction_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_RUNTIME_USER=badaction_app
POSTGRES_RUNTIME_PASSWORD=

# URL-encode reserved characters in passwords when filling these URLs.
DOCKER_MIGRATOR_DATABASE_URL=
DOCKER_RUNTIME_DATABASE_URL=

DOCKER_VISITOR_TOKEN_SECRET=
DOCKER_BOARD_ACCESS_SECRET=
DOCKER_RATE_LIMIT_KEY_SECRET=
# Example: https://retro.example.com (replace it with the real public origin).
DOCKER_APP_ORIGIN=

# The application remains bound to loopback; terminate HTTPS at a host proxy.
APP_PORT=3000
POSTGRES_PORT=5432

# Set this to the exact number of trusted reverse-proxy hops. Keep 0 when the
# proxy does not supply a trustworthy X-Forwarded-For chain.
TRUSTED_PROXY_HOPS=0

BOARD_RETENTION_DAYS=90
BOARD_CARD_LIMIT=500
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_MINUTES=60
RETENTION_CLEANUP_BATCH_SIZE=1000

# Optional verified, immutable image references. Leave unset to build locally.
# DOCKER_RUNNER_IMAGE=registry.example/badaction-runner@sha256:<verified-digest>
# DOCKER_MIGRATOR_IMAGE=registry.example/badaction-migrator@sha256:<verified-digest>
