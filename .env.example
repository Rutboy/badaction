DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retro?schema=public"
VISITOR_TOKEN_SECRET="dev-only-visitor-token-secret-change-me"
BOARD_ACCESS_SECRET="dev-only-board-access-secret-change-me"
RATE_LIMIT_KEY_SECRET="dev-only-rate-limit-key-secret-change-me"
APP_ORIGIN="http://localhost:3000"
TRUSTED_PROXY_HOPS="0"
BOARD_RETENTION_DAYS="90"
BOARD_CARD_LIMIT="500"
RETENTION_CLEANUP_ENABLED="true"
RETENTION_CLEANUP_INTERVAL_MINUTES="60"
RETENTION_CLEANUP_BATCH_SIZE="1000"
NEXT_TELEMETRY_DISABLED="1"

# Docker Compose host ports. Keep APP_PORT and DOCKER_APP_ORIGIN aligned;
# when POSTGRES_PORT changes, update the host-side DATABASE_URL above as well.
APP_PORT="3000"
POSTGRES_PORT="5432"
DOCKER_APP_ORIGIN="http://localhost:3000"

# Optional prebuilt image overrides used by the Compose app profile and smoke test.
# Leave unset for local builds; set both only to verified immutable references.
# DOCKER_RUNNER_IMAGE="registry.example/badaction-runner@sha256:<verified-digest>"
# DOCKER_MIGRATOR_IMAGE="registry.example/badaction-migrator@sha256:<verified-digest>"
